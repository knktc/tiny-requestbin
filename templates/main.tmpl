<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tiny RequestBin</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="shortcut icon" href="/favicon.ico">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        // 语言翻译字典
        const translations = {
            'en': {
                'title': 'Tiny RequestBin',
                'subtitle_prefix': 'Send requests to',
                'example_path_placeholder': 'your-path',
                'copy_example_url': 'Copy example URL',
                'request_path_input': 'Request path',
                'auto_refresh': 'Auto Refresh',
                'auto_refresh_active': 'Live',
                'auto_refresh_inactive': 'Auto Off',
                'refresh_once': 'Refresh',
                'seconds': 'seconds',
                'refresh': 'Refresh',
                'clear_requests': 'Clear',
                'search_path': 'Search path',
                'search_toggle': 'Toggle path search',
                'search_path_placeholder': 'Filter by path, e.g. /api',
                'confirm': 'Confirm',
                'clear_confirm': 'Clear all captured requests?',
                'captured_requests': 'Captured Requests',
                'no_requests': 'No requests captured yet.',
                'no_filtered_requests': 'No requests match the current path filter.',
                'welcome_title': 'Welcome!',
                'welcome_message': 'Please select a request from the list on the left to view details.',
                'request_details': 'Request Details',
                'time': 'Time',
                'method': 'Method',
                'path': 'Path',
                'protocol': 'Protocol',
                'source_ip': 'Source IP',
                'query_parameters': 'Query Parameters',
                'no_query_parameters': 'No query parameters.',
                'headers': 'Headers',
                'body': 'Body',
                'no_body': 'This request has no body.',
                'copy': 'Copy',
                'copied': 'Copied!',
                'copy_failed': 'Failed',
                'details_load_failed': 'Could not load request details. Please try again.'
            },
            'zh-CN': {
                'title': 'Tiny RequestBin',
                'subtitle_prefix': '发送请求到',
                'example_path_placeholder': 'your-path',
                'copy_example_url': '复制示例地址',
                'request_path_input': '请求路径',
                'auto_refresh': '自动刷新',
                'auto_refresh_active': '自动刷新中',
                'auto_refresh_inactive': '自动刷新关闭',
                'refresh_once': '刷新',
                'seconds': '秒',
                'refresh': '刷新',
                'clear_requests': '清空',
                'search_path': '搜索路径',
                'search_toggle': '切换路径搜索',
                'search_path_placeholder': '按路径过滤，例如 /api',
                'confirm': '确定',
                'clear_confirm': '确定清空所有已捕获的请求？',
                'captured_requests': '已捕获的请求',
                'no_requests': '尚未捕获任何请求。',
                'no_filtered_requests': '当前路径筛选下没有匹配的请求。',
                'welcome_title': '欢迎！',
                'welcome_message': '请从左侧列表中选择一个请求以查看其详细信息。',
                'request_details': '请求详情',
                'time': '时间',
                'method': '方法',
                'path': '路径',
                'protocol': '协议',
                'source_ip': '源 IP',
                'query_parameters': '查询参数',
                'no_query_parameters': '没有查询参数。',
                'headers': '标头 (Headers)',
                'body': '正文 (Body)',
                'no_body': '该请求没有正文。',
                'copy': '复制',
                'copied': '已复制！',
                'copy_failed': '失败',
                'details_load_failed': '无法加载请求详情，请重试。'
            }
        };

        // 设置当前语言
        let currentLang = 'en';

        function normalizeLanguage(lang) {
            if (!lang) {
                return null;
            }

            const normalized = String(lang).trim().toLowerCase();
            if (normalized === 'zh' || normalized === 'zh-cn' || normalized.startsWith('zh-')) {
                return 'zh-CN';
            }
            if (normalized === 'en' || normalized === 'en-us' || normalized.startsWith('en-')) {
                return 'en';
            }

            return null;
        }
        
        // 语言检测和初始化函数
        function initLanguage() {
            const urlLang = normalizeLanguage(new URLSearchParams(window.location.search).get('lang'));
            const browserLang = normalizeLanguage(navigator.language || navigator.userLanguage);

            currentLang = urlLang || browserLang || 'en';
            
            // 设置HTML的lang属性
            document.documentElement.lang = currentLang;
            
            // 应用翻译
            applyTranslations();
        }
        
        // 应用翻译到页面
        function applyTranslations(root = document) {
            const elements = root.querySelectorAll('[data-i18n]');
            elements.forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (translations[currentLang][key]) {
                    el.innerHTML = translations[currentLang][key];
                }
            });

            const placeholderElements = root.querySelectorAll('[data-i18n-placeholder]');
            placeholderElements.forEach(el => {
                const key = el.getAttribute('data-i18n-placeholder');
                if (translations[currentLang][key]) {
                    el.setAttribute('placeholder', translations[currentLang][key]);
                }
            });
            
            if (root !== document) return;

            // 特殊处理一些动态元素
            document.title = translations[currentLang]['title'];
            renderSubtitle();

            const togglePathSearchButton = document.getElementById('togglePathSearchButton');
            if (togglePathSearchButton) {
                const searchToggleLabel = translations[currentLang]['search_toggle'] || 'Toggle path search';
                togglePathSearchButton.title = searchToggleLabel;
                togglePathSearchButton.setAttribute('aria-label', searchToggleLabel);
            }
        }

        function renderSubtitle() {
            const subtitle = document.getElementById('subtitle');
            if (!subtitle) return;

            const origin = window.location.origin || `${window.location.protocol}//${window.location.host}`;
            const prefix = translations[currentLang]['subtitle_prefix'] || '';
            const pathPlaceholder = translations[currentLang]['example_path_placeholder'] || 'your-path';

            const subtitleUrl = document.getElementById('subtitle-url');
            if (subtitleUrl) {
                subtitleUrl.textContent = `${origin}/`;
            }

            const subtitlePrefix = document.getElementById('subtitle-prefix');
            if (subtitlePrefix) {
                subtitlePrefix.textContent = `${prefix} `;
            }

            const subtitlePathInput = document.getElementById('subtitle-path-input');
            if (subtitlePathInput) {
                subtitlePathInput.placeholder = pathPlaceholder;
                const pathInputLabel = translations[currentLang]['request_path_input'] || 'Request path';
                subtitlePathInput.setAttribute('aria-label', pathInputLabel);
                updateSubtitlePathInputWidth();
            }

            const copySubtitleBtn = document.getElementById('copy-subtitle-btn');
            if (copySubtitleBtn) {
                const copyLabel = translations[currentLang]['copy_example_url'] || 'Copy example URL';
                copySubtitleBtn.title = copyLabel;
                copySubtitleBtn.setAttribute('aria-label', copyLabel);
            }
        }

        function getSubtitlePathValue() {
            const subtitlePathInput = document.getElementById('subtitle-path-input');
            const fallbackPath = translations[currentLang]['example_path_placeholder'] || 'your-path';
            const rawValue = subtitlePathInput ? subtitlePathInput.value.trim() : '';

            if (!rawValue) {
                return fallbackPath;
            }

            return rawValue.replace(/^\/+/, '');
        }

        function getSubtitleCopyUrl() {
            const subtitleUrl = document.getElementById('subtitle-url');
            if (!subtitleUrl) return '';

            const baseUrl = subtitleUrl.textContent || subtitleUrl.innerText || '';
            return `${baseUrl}${getSubtitlePathValue()}`;
        }

        function updateSubtitlePathInputWidth() {
            const subtitlePathInput = document.getElementById('subtitle-path-input');
            const subtitlePathMeasure = document.getElementById('subtitle-path-measure');
            if (!subtitlePathInput || !subtitlePathMeasure) return;

            const fallbackPath = translations[currentLang]['example_path_placeholder'] || 'your-path';
            subtitlePathMeasure.textContent = subtitlePathInput.value || subtitlePathInput.placeholder || fallbackPath;
            const measuredWidth = Math.ceil(subtitlePathMeasure.getBoundingClientRect().width) + 6;
            subtitlePathInput.style.width = `${Math.max(measuredWidth, 72)}px`;
        }

        async function copyText(text) {
            if (navigator.clipboard && window.isSecureContext) {
                await navigator.clipboard.writeText(text);
                return;
            }

            const textArea = document.createElement('textarea');
            textArea.value = text;
            textArea.style.position = 'fixed';
            textArea.style.opacity = '0';
            document.body.appendChild(textArea);
            textArea.focus();
            textArea.select();
            document.execCommand('copy');
            document.body.removeChild(textArea);
        }
        
    </script>
</head>
<body class="bg-gray-100 text-gray-800 font-sans h-screen flex flex-col">
    <header class="border-b bg-white shadow-sm">
        <div class="flex items-start gap-3 px-5 py-3">
            <div class="mt-0.5 inline-flex h-10 w-10 shrink-0 items-center justify-center">
                <img src="/favicon.svg" alt="" class="h-10 w-10 rounded-xl shadow-sm" aria-hidden="true">
            </div>
            <div class="min-w-0">
                <h1 class="text-xl font-bold leading-tight text-gray-900" data-i18n="title">Tiny RequestBin</h1>
                <div id="subtitle" class="mt-1 flex items-center gap-2 text-xs text-gray-600 sm:text-sm">
                    <p class="min-w-0">
                        <span id="subtitle-prefix">Send requests to </span><span id="subtitle-url" class="font-mono">{{.BaseURL}}/</span><input id="subtitle-path-input" type="text" placeholder="your-path" class="border-0 border-b border-dashed border-gray-300 bg-transparent px-0.5 font-mono text-inherit focus:border-indigo-400 focus:outline-none focus:ring-0" aria-label="Request path"><span id="subtitle-path-measure" class="invisible absolute left-[-9999px] top-[-9999px] whitespace-pre px-0.5 font-mono text-sm"></span>
                    </p>
                    <button id="copy-subtitle-btn" class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-md text-gray-500 transition-colors hover:bg-slate-100 hover:text-gray-800 focus:outline-none focus:ring-2 focus:ring-indigo-200" title="Copy example URL" aria-label="Copy example URL">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <div class="flex flex-1 overflow-hidden">
        <!-- Left Column: Request List -->
        <aside class="w-1/3 bg-white border-r flex flex-col">
            <div class="p-4 border-b flex items-center justify-between gap-3">
                <div class="flex items-center gap-2">
                    <h2 class="text-lg font-semibold" data-i18n="captured_requests">已捕获的请求</h2>
                    <button id="togglePathSearchButton" class="inline-flex h-8 w-8 items-center justify-center rounded-md text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-200" title="Toggle path search" aria-label="Toggle path search" aria-expanded="false" aria-controls="pathSearchPanel">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m21 21-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                    </button>
                </div>
                <div class="flex items-center gap-2">
                    <div id="refreshControlGroup" class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 text-xs font-semibold text-slate-700 overflow-hidden">
                        <button id="autoRefreshToggleButton" class="inline-flex items-center gap-2 px-2.5 py-1.5 transition-colors hover:bg-slate-100">
                            <span id="autoRefreshStatusDot" class="h-2 w-2 rounded-full bg-slate-400"></span>
                            <span id="autoRefreshButtonLabel" data-i18n="auto_refresh_inactive">自动刷新</span>
                        </button>
                        <div class="h-4 w-px bg-slate-200"></div>
                        <label for="refreshIntervalInput" class="sr-only" data-i18n="seconds">秒</label>
                        <button id="autoRefreshCountdownDisplay" type="button" class="hidden items-center gap-1 px-2 py-1.5 text-emerald-700 transition-colors hover:bg-emerald-100" title="Edit refresh interval">
                            <span id="autoRefreshCountdownValue" class="min-w-5 text-center tabular-nums">5</span>
                            <span data-i18n="seconds">秒</span>
                        </button>
                        <div id="refreshIntervalEditor" class="hidden items-center gap-1 px-2 py-1.5 text-emerald-700">
                            <input type="number" id="refreshIntervalInput" class="w-8 border-0 bg-transparent p-0 text-center text-xs font-semibold text-inherit focus:outline-none focus:ring-0" min="1" value="5">
                            <span data-i18n="seconds">秒</span>
                        </div>
                    </div>
                    <button id="listRefreshButton" class="inline-flex h-8 w-8 items-center justify-center rounded-md text-blue-600 transition-colors hover:bg-blue-50 hover:text-blue-700" title="Refresh" aria-label="Refresh">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                        </svg>
                    </button>
                    <button id="clearRequestsButton" class="px-3 py-1.5 text-xs font-semibold text-red-700 bg-red-50 border border-red-200 rounded-md hover:bg-red-100 hover:border-red-300 transition-colors flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                            <path d="M8.5 2a1 1 0 00-1 1v1H4.75a.75.75 0 000 1.5h10.5a.75.75 0 000-1.5H12.5V3a1 1 0 00-1-1h-3z" />
                            <path d="M6 7.25a.75.75 0 01.75-.75h6.5a.75.75 0 01.75.75v7.25a2 2 0 01-2 2h-4a2 2 0 01-2-2V7.25z" />
                        </svg>
                        <span data-i18n="clear_requests">清理</span>
                    </button>
                </div>
            </div>
            <div id="pathSearchPanel" class="hidden p-4 border-b bg-gray-50">
                <label for="pathSearchInput" class="mb-2 block text-sm font-medium text-gray-700" data-i18n="search_path">搜索路径</label>
                <input
                    id="pathSearchInput"
                    type="search"
                    value="{{.PathFilter}}"
                    data-i18n-placeholder="search_path_placeholder"
                    placeholder="按路径过滤，例如 /api"
                    class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200"
                >
            </div>
            <div class="overflow-y-auto flex-1">
                {{if .AllRequests}}
                <ul class="divide-y" id="requestList">
                    {{range .AllRequests}}
                    <a href="#" data-request-id="{{.ID}}" class="request-link block p-4 hover:bg-gray-50 {{if isCurrent .ID $.SelectedRequest}}bg-indigo-50 border-l-4 border-indigo-500{{end}}">
                        <div class="flex justify-between items-center mb-1">
                            <div class="font-bold truncate {{if isCurrent .ID $.SelectedRequest}}text-indigo-700{{else}}text-gray-800{{end}}">
                                <span class="px-2 mr-2 text-xs leading-5 font-semibold rounded-full 
                                    {{if eq .Method "GET"}} bg-green-100 text-green-800
                                    {{else if eq .Method "POST"}} bg-blue-100 text-blue-800
                                    {{else if eq .Method "PUT"}} bg-yellow-100 text-yellow-800
                                    {{else if eq .Method "DELETE"}} bg-red-100 text-red-800
                                    {{else}} bg-gray-100 text-gray-800 {{end}}">
                                    {{.Method}}
                                </span>
                                <span class="font-mono">{{if .RequestURI}}{{.RequestURI}}{{else}}{{.Path}}{{end}}</span>
                            </div>
                        </div>
                        <div class="text-xs text-gray-500">{{.Timestamp | formatTime}}</div>
                    </a>
                {{end}}
                </ul>
                {{else}}
                <div class="p-6 text-center text-gray-500">
                    <p data-i18n="{{if .PathFilter}}no_filtered_requests{{else}}no_requests{{end}}">{{if .PathFilter}}当前路径筛选下没有匹配的请求。{{else}}尚未捕获任何请求。{{end}}</p>
                </div>
                {{end}}
            </div>
            <!-- Pagination Controls -->
            <div id="paginationControls" class="p-4 border-t bg-gray-50">
                <div class="flex items-center justify-between text-sm">
                    <div class="text-gray-600">
                        <span id="paginationInfo">第 1 页，共 1 页 (总计 {{len .AllRequests}} 个请求)</span>
                    </div>
                    <div class="flex space-x-2">
                        <button id="prevPageBtn" class="px-3 py-1 text-sm bg-gray-200 text-gray-600 rounded hover:bg-gray-300 disabled:opacity-50 disabled:cursor-not-allowed" disabled>
                            上一页
                        </button>
                        <button id="nextPageBtn" class="px-3 py-1 text-sm bg-gray-200 text-gray-600 rounded hover:bg-gray-300 disabled:opacity-50 disabled:cursor-not-allowed">
                            下一页
                        </button>
                    </div>
                </div>
            </div>
        </aside>

        <div id="detailsLoadError" role="alert" class="hidden fixed bottom-4 right-4 rounded-md bg-red-50 px-4 py-3 text-sm text-red-700" data-i18n="details_load_failed"></div>

        <!-- Right Column: Request Details -->
        <main class="w-2/3 overflow-y-auto p-4 md:p-8">
            {{if .SelectedRequest}}
            {{template "request-details" .SelectedRequest}}
            {{else}}
            {{template "empty-details"}}
            {{end}}
        </main>
    </div>
    <!-- Shared markup for server rendering and JSON-driven detail updates. -->
    <template id="request-details-template">{{template "request-details"}}</template>
    <template id="empty-details-template">{{template "empty-details"}}</template>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Initialize language first
            initLanguage();
            
            // --- Pagination variables ---
            let currentPage = 1;
            let totalPages = 1;
            let isUpdating = false;
            
            // --- Auto-refresh logic ---
            const autoRefreshToggleButton = document.getElementById('autoRefreshToggleButton');
            const autoRefreshButtonLabel = document.getElementById('autoRefreshButtonLabel');
            const autoRefreshStatusDot = document.getElementById('autoRefreshStatusDot');
            const refreshControlGroup = document.getElementById('refreshControlGroup');
            const autoRefreshCountdownDisplay = document.getElementById('autoRefreshCountdownDisplay');
            const autoRefreshCountdownValue = document.getElementById('autoRefreshCountdownValue');
            const refreshIntervalEditor = document.getElementById('refreshIntervalEditor');
            const intervalInput = document.getElementById('refreshIntervalInput');
            const clearRequestsButton = document.getElementById('clearRequestsButton');
            const listRefreshButton = document.getElementById('listRefreshButton');
            const pathSearchInput = document.getElementById('pathSearchInput');
            const pathSearchPanel = document.getElementById('pathSearchPanel');
            const togglePathSearchButton = document.getElementById('togglePathSearchButton');
            const subtitlePathInput = document.getElementById('subtitle-path-input');
            const requestList = document.querySelector('aside .overflow-y-auto');
            let autoRefreshTimer;
            let countdownInterval;
            let countdownSeconds = 5;
            let searchDebounceTimer;
            let currentPathFilter = new URLSearchParams(window.location.search).get('path') || '';
            let isAutoRefreshEnabled = true;
            let isPathSearchOpen = currentPathFilter !== '';
            let isEditingRefreshInterval = false;

            // --- Pagination controls ---
            const prevPageBtn = document.getElementById('prevPageBtn');
            const nextPageBtn = document.getElementById('nextPageBtn');
            const paginationInfo = document.getElementById('paginationInfo');
            const paginationControls = document.getElementById('paginationControls');

            if (pathSearchInput) {
                pathSearchInput.value = currentPathFilter;
            }

            function updatePathSearchToggleButton() {
                if (!togglePathSearchButton) {
                    return;
                }

                const activeClasses = ['bg-indigo-50', 'text-indigo-700'];
                const inactiveClasses = ['text-slate-500', 'hover:bg-slate-100', 'hover:text-slate-700'];

                togglePathSearchButton.setAttribute('aria-expanded', String(isPathSearchOpen));
                if (currentPathFilter) {
                    togglePathSearchButton.classList.remove(...inactiveClasses);
                    togglePathSearchButton.classList.add(...activeClasses);
                } else {
                    togglePathSearchButton.classList.remove(...activeClasses);
                    togglePathSearchButton.classList.add(...inactiveClasses);
                }
            }

            function setPathSearchOpen(nextOpen, { focusInput = false } = {}) {
                if (!pathSearchPanel) {
                    return;
                }

                isPathSearchOpen = nextOpen;
                pathSearchPanel.classList.toggle('hidden', !isPathSearchOpen);
                updatePathSearchToggleButton();

                if (focusInput && isPathSearchOpen && pathSearchInput) {
                    requestAnimationFrame(() => {
                        pathSearchInput.focus();
                        pathSearchInput.select();
                    });
                }
            }

            function getRefreshIntervalSeconds() {
                let interval = parseInt(intervalInput.value, 10);
                if (isNaN(interval) || interval < 1) {
                    interval = 5;
                    intervalInput.value = '5';
                }
                return interval;
            }

            function updateCountdownDisplay() {
                if (autoRefreshCountdownValue) {
                    autoRefreshCountdownValue.textContent = String(countdownSeconds);
                }
            }

            function beginRefreshIntervalEdit() {
                if (!isAutoRefreshEnabled || !refreshIntervalEditor || !intervalInput) {
                    return;
                }
                isEditingRefreshInterval = true;
                updateRefreshControls();
                requestAnimationFrame(() => {
                    intervalInput.focus();
                    intervalInput.select();
                });
            }

            function finishRefreshIntervalEdit({ apply = true } = {}) {
                if (!isEditingRefreshInterval) {
                    return;
                }

                if (apply) {
                    const interval = getRefreshIntervalSeconds();
                    localStorage.setItem('autoRefreshInterval', String(interval));
                    if (isAutoRefreshEnabled) {
                        startRefresh();
                    }
                }

                isEditingRefreshInterval = false;
                updateRefreshControls();
            }

            function stopRefresh() {
                clearTimeout(autoRefreshTimer);
                clearInterval(countdownInterval);
                autoRefreshTimer = null;
                countdownInterval = null;
            }

            function startRefresh() {
                stopRefresh();
                countdownSeconds = getRefreshIntervalSeconds();
                updateCountdownDisplay();

                countdownInterval = setInterval(() => {
                    countdownSeconds = Math.max(0, countdownSeconds - 1);
                    updateCountdownDisplay();
                }, 1000);

                autoRefreshTimer = setTimeout(() => {
                    clearInterval(countdownInterval);
                    countdownInterval = null;
                    countdownSeconds = 0;
                    updateCountdownDisplay();

                    Promise.resolve(updateRequestList(currentPage))
                        .catch(() => {})
                        .finally(() => {
                            if (isAutoRefreshEnabled) {
                                startRefresh();
                            }
                        });
                }, countdownSeconds * 1000);
            }

            function updateRefreshControls() {
                if (!autoRefreshToggleButton || !autoRefreshButtonLabel || !autoRefreshStatusDot || !refreshControlGroup || !listRefreshButton || !autoRefreshCountdownDisplay || !refreshIntervalEditor || !intervalInput) {
                    return;
                }

                if (isAutoRefreshEnabled) {
                    refreshControlGroup.className = 'inline-flex items-center rounded-full border border-emerald-200 bg-emerald-50 text-xs font-semibold text-emerald-700 overflow-hidden';
                    autoRefreshToggleButton.className = 'inline-flex items-center gap-2 px-2.5 py-1.5 transition-colors hover:bg-emerald-100';
                    autoRefreshButtonLabel.textContent = translations[currentLang]['auto_refresh_active'];
                    autoRefreshStatusDot.className = 'h-2 w-2 rounded-full bg-emerald-500';
                    if (isEditingRefreshInterval) {
                        autoRefreshCountdownDisplay.classList.add('hidden');
                        autoRefreshCountdownDisplay.classList.remove('inline-flex');
                        refreshIntervalEditor.classList.remove('hidden');
                        refreshIntervalEditor.classList.add('inline-flex');
                    } else {
                        autoRefreshCountdownDisplay.classList.remove('hidden');
                        autoRefreshCountdownDisplay.classList.add('inline-flex');
                        refreshIntervalEditor.classList.add('hidden');
                        refreshIntervalEditor.classList.remove('inline-flex');
                    }
                    intervalInput.disabled = false;
                    listRefreshButton.classList.add('hidden');
                } else {
                    refreshControlGroup.className = 'inline-flex items-center rounded-full border border-slate-200 bg-slate-50 text-xs font-semibold text-slate-700 overflow-hidden';
                    autoRefreshToggleButton.className = 'inline-flex items-center gap-2 px-2.5 py-1.5 transition-colors hover:bg-slate-100';
                    autoRefreshButtonLabel.textContent = translations[currentLang]['auto_refresh_inactive'];
                    autoRefreshStatusDot.className = 'h-2 w-2 rounded-full bg-slate-400';
                    autoRefreshCountdownDisplay.classList.add('hidden');
                    autoRefreshCountdownDisplay.classList.remove('inline-flex');
                    refreshIntervalEditor.classList.add('hidden');
                    refreshIntervalEditor.classList.remove('inline-flex');
                    intervalInput.disabled = true;
                    listRefreshButton.classList.remove('hidden');
                }
            }

            function syncUrlParams({ page = currentPage, path = currentPathFilter, viewId } = {}) {
                const url = new URL(window.location);

                if (path) {
                    url.searchParams.set('path', path);
                } else {
                    url.searchParams.delete('path');
                }

                if (page > 1) {
                    url.searchParams.set('page', page);
                } else {
                    url.searchParams.delete('page');
                }

                if (viewId) {
                    url.searchParams.set('view_id', viewId);
                } else if (viewId === null) {
                    url.searchParams.delete('view_id');
                }

                window.history.replaceState({}, '', url);
            }


            // Function to update pagination info
            function updatePaginationInfo(data) {
                const { page, total_pages, total } = data;
                paginationInfo.textContent = `第 ${page} 页，共 ${total_pages} 页 (总计 ${total} 个请求)`;
                
                prevPageBtn.disabled = !data.has_prev;
                nextPageBtn.disabled = !data.has_next;
                
                currentPage = page;
                totalPages = total_pages;
                
                // Show/hide pagination controls based on whether there are multiple pages
                if (total_pages > 1) {
                    paginationControls.classList.remove('hidden');
                } else {
                    paginationControls.classList.add('hidden');
                }
            }

            // Function to update only the request list via AJAX
            function updateRequestList(page = currentPage, { resetAutoRefresh = false } = {}) {
                if (isUpdating) return;
                if (resetAutoRefresh && isAutoRefreshEnabled) {
                    stopRefresh();
                }
                isUpdating = true;
                const params = new URLSearchParams({
                    page: String(page),
                    limit: '20'
                });

                if (currentPathFilter) {
                    params.set('path', currentPathFilter);
                }
                
                return fetch(`/__tiny_requestbin/api/requests?${params.toString()}`)
                    .then(response => response.json())
                    .then(data => {
                        const currentViewId = new URLSearchParams(window.location.search).get('view_id');
                        
                        updatePaginationInfo(data);
                        syncUrlParams({ page: data.page, path: currentPathFilter });
                        
                        if (data.requests && data.requests.length > 0) {
                            const ul = document.createElement('ul');
                            ul.className = 'divide-y';
                            ul.id = 'requestList';
                            
                            data.requests.forEach(request => {
                                const li = document.createElement('a');
                                li.href = '#';
                                li.setAttribute('data-request-id', request.ID);
                                li.className = `request-link block p-4 hover:bg-gray-50 ${currentViewId == request.ID ? 'bg-indigo-50 border-l-4 border-indigo-500' : ''}`;
                                
                                const methodColor = getMethodColor(request.Method);
                                const timestamp = formatTime(request.Timestamp);
                                
                                li.innerHTML = `
                                    <div class="flex justify-between items-center mb-1">
                                        <div class="font-bold truncate ${currentViewId == request.ID ? 'text-indigo-700' : 'text-gray-800'}">
                                            <span class="px-2 mr-2 text-xs leading-5 font-semibold rounded-full ${methodColor}">
                                                ${request.Method}
                                            </span>
                                            <span class="font-mono">${request.RequestURI || request.Path}</span>
                                        </div>
                                    </div>
                                    <div class="text-xs text-gray-500">${timestamp}</div>
                                `;
                                
                                // Add click event listener
                                li.addEventListener('click', handleRequestClick);
                                
                                ul.appendChild(li);
                            });
                            
                            requestList.innerHTML = '';
                            requestList.appendChild(ul);
                        } else {
                            const emptyMessageKey = currentPathFilter ? 'no_filtered_requests' : 'no_requests';
                            requestList.innerHTML = `
                                <div class="p-6 text-center text-gray-500">
                                    <p data-i18n="${emptyMessageKey}">${translations[currentLang][emptyMessageKey]}</p>
                                </div>
                            `;
                        }
                    })
                    .catch(error => {
                        console.error('Error updating request list:', error);
                    })
                    .finally(() => {
                        isUpdating = false;
                        if (resetAutoRefresh && isAutoRefreshEnabled) {
                            startRefresh();
                        }
                    });
            }

            // Helper function to get method color class
            function getMethodColor(method) {
                switch(method) {
                    case 'GET': return 'bg-green-100 text-green-800';
                    case 'POST': return 'bg-blue-100 text-blue-800';
                    case 'PUT': return 'bg-yellow-100 text-yellow-800';
                    case 'DELETE': return 'bg-red-100 text-red-800';
                    default: return 'bg-gray-100 text-gray-800';
                }
            }

            // Helper function to format time in the same format as server-side formatTime
            function formatTime(dateString) {
                const date = new Date(dateString);
                const year = date.getFullYear();
                const month = String(date.getMonth() + 1).padStart(2, '0');
                const day = String(date.getDate()).padStart(2, '0');
                const hours = String(date.getHours()).padStart(2, '0');
                const minutes = String(date.getMinutes()).padStart(2, '0');
                const seconds = String(date.getSeconds()).padStart(2, '0');
                return `${year}-${month}-${day} ${hours}:${minutes}:${seconds}`;
            }

            // Pagination button event listeners
            prevPageBtn.addEventListener('click', () => {
                if (currentPage > 1) {
                    updateRequestList(currentPage - 1, { resetAutoRefresh: true });
                }
            });

            nextPageBtn.addEventListener('click', () => {
                if (currentPage < totalPages) {
                    updateRequestList(currentPage + 1, { resetAutoRefresh: true });
                }
            });

            autoRefreshToggleButton.addEventListener('click', () => {
                localStorage.setItem('autoRefreshInterval', String(getRefreshIntervalSeconds()));
                isAutoRefreshEnabled = !isAutoRefreshEnabled;
                if (isAutoRefreshEnabled) {
                    localStorage.setItem('autoRefreshEnabled', 'true');
                    startRefresh();
                } else {
                    localStorage.setItem('autoRefreshEnabled', 'false');
                    isEditingRefreshInterval = false;
                    stopRefresh();
                }
                updateRefreshControls();
            });

            if (autoRefreshCountdownDisplay) {
                autoRefreshCountdownDisplay.addEventListener('click', () => {
                    beginRefreshIntervalEdit();
                });
            }


            if (clearRequestsButton) {
                let isConfirmingClear = false;
                let clearConfirmTimer = null;
                const clearOriginalClasses = clearRequestsButton.className;
                const clearOriginalLabel = clearRequestsButton.innerHTML;

                const resetClearButton = () => {
                    isConfirmingClear = false;
                    clearRequestsButton.className = clearOriginalClasses;
                    clearRequestsButton.innerHTML = clearOriginalLabel;
                    if (clearConfirmTimer) {
                        clearTimeout(clearConfirmTimer);
                        clearConfirmTimer = null;
                    }
                };

                clearRequestsButton.addEventListener('click', async () => {
                    if (clearRequestsButton.disabled) return;

                    if (!isConfirmingClear) {
                        isConfirmingClear = true;
                        clearRequestsButton.className = 'px-3 py-1.5 text-xs font-semibold text-white bg-red-600 border border-red-600 rounded-md hover:bg-red-700 transition-colors flex items-center gap-1.5';
                        clearRequestsButton.innerHTML = `
                            <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path fill-rule="evenodd" d="M16.704 6.29a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0l-3.25-3.25a.75.75 0 111.06-1.06l2.72 2.72 6.72-6.72a.75.75 0 011.06 0z" clip-rule="evenodd" />
                            </svg>
                            <span data-i18n="confirm">${translations[currentLang]['confirm']}</span>
                        `;
                        clearConfirmTimer = setTimeout(resetClearButton, 2500);
                        return;
                    }

                    clearRequestsButton.disabled = true;
                    clearRequestsButton.classList.add('opacity-60', 'cursor-not-allowed');

                    try {
                        const response = await fetch('/__tiny_requestbin/api/requests/clear', { method: 'POST' });
                        if (!response.ok) {
                            throw new Error('clear_failed');
                        }
                        window.location.href = '/';
                    } catch (error) {
                        console.error('Error clearing requests:', error);
                        clearRequestsButton.disabled = false;
                        clearRequestsButton.classList.remove('opacity-60', 'cursor-not-allowed');
                        resetClearButton();
                    }
                });
            }

            if (pathSearchInput) {
                pathSearchInput.addEventListener('input', () => {
                    currentPathFilter = pathSearchInput.value.trim();
                    currentPage = 1;
                    updatePathSearchToggleButton();

                    if (searchDebounceTimer) {
                        clearTimeout(searchDebounceTimer);
                    }

                    syncUrlParams({ page: 1, path: currentPathFilter, viewId: null });
                    searchDebounceTimer = setTimeout(() => {
                        updateRequestList(1, { resetAutoRefresh: true });
                    }, 300);
                });
            }

            if (subtitlePathInput) {
                subtitlePathInput.addEventListener('input', updateSubtitlePathInputWidth);
                subtitlePathInput.addEventListener('focus', updateSubtitlePathInputWidth);
                subtitlePathInput.addEventListener('blur', updateSubtitlePathInputWidth);
            }

            if (togglePathSearchButton) {
                togglePathSearchButton.addEventListener('click', () => {
                    const nextOpen = !isPathSearchOpen;
                    setPathSearchOpen(nextOpen, { focusInput: nextOpen });
                });
            }

            if (listRefreshButton) {
                listRefreshButton.addEventListener('click', () => {
                    if (isUpdating) return;
                    const refreshIcon = listRefreshButton.querySelector('svg');
                    listRefreshButton.disabled = true;
                    listRefreshButton.classList.add('opacity-70', 'cursor-not-allowed');
                    if (refreshIcon) {
                        refreshIcon.classList.add('animate-spin');
                    }
                    Promise.resolve(updateRequestList(currentPage, { resetAutoRefresh: true }))
                        .catch(() => {})
                        .finally(() => {
                            if (refreshIcon) {
                                refreshIcon.classList.remove('animate-spin');
                            }
                            listRefreshButton.disabled = false;
                            listRefreshButton.classList.remove('opacity-70', 'cursor-not-allowed');
                        });
                });
            }
            
            intervalInput.addEventListener('blur', () => {
                finishRefreshIntervalEdit({ apply: true });
            });
            intervalInput.addEventListener('keydown', (event) => {
                if (event.key === 'Enter') {
                    event.preventDefault();
                    finishRefreshIntervalEdit({ apply: true });
                } else if (event.key === 'Escape') {
                    event.preventDefault();
                    finishRefreshIntervalEdit({ apply: false });
                }
            });

            // 页面加载时恢复设置
            const savedInterval = localStorage.getItem('autoRefreshInterval') || '5';
            intervalInput.value = savedInterval;
            isAutoRefreshEnabled = localStorage.getItem('autoRefreshEnabled') !== 'false';
            const initialPage = parseInt(new URLSearchParams(window.location.search).get('page') || '1', 10);
            if (!Number.isNaN(initialPage) && initialPage > 0) {
                currentPage = initialPage;
            }
            setPathSearchOpen(isPathSearchOpen);
            updateSubtitlePathInputWidth();
            if (isAutoRefreshEnabled) {
                startRefresh();
            }
            updateRefreshControls();
            updateCountdownDisplay();

            // Initialize pagination and request list
            updateRequestList(currentPage);

            // Keep the surrounding page mounted when switching requests.
            let detailsController = null;
            const detailsLoadError = document.getElementById('detailsLoadError');

            function updateSelectedRequest(requestId) {
                document.querySelectorAll('.request-link').forEach(link => {
                    const selected = link.dataset.requestId === requestId;
                    link.classList.toggle('bg-indigo-50', selected);
                    link.classList.toggle('border-l-4', selected);
                    link.classList.toggle('border-indigo-500', selected);
                    const title = link.querySelector('.font-bold');
                    if (title) {
                        title.classList.toggle('text-indigo-700', selected);
                        title.classList.toggle('text-gray-800', !selected);
                    }
                });
            }

            function handleRequestClick(event) {
                event.preventDefault();
                const requestId = event.currentTarget.getAttribute('data-request-id');
                if (requestId !== null) {
                    const newUrl = new URL(window.location);
                    newUrl.searchParams.set('view_id', requestId);
                    loadRequestDetails(newUrl, { pushHistory: true });
                }
            }

            document.querySelectorAll('.request-link').forEach(link => {
                link.addEventListener('click', handleRequestClick);
            });

            window.addEventListener('popstate', () => {
                const params = new URLSearchParams(window.location.search);
                currentPathFilter = params.get('path') || '';
                currentPage = Math.max(1, parseInt(params.get('page') || '1', 10) || 1);
                pathSearchInput.value = currentPathFilter;
                setPathSearchOpen(currentPathFilter !== '');
                loadRequestDetails(new URL(window.location));
                updateRequestList(currentPage);
            });

            function renderRequestDetails(request) {
                const templateId = request ? 'request-details-template' : 'empty-details-template';
                const content = document.getElementById(templateId).content.cloneNode(true);
                if (!request) {
                    applyTranslations(content);
                    return content;
                }

                // Captured data is untrusted: insert text, never HTML.
                const setText = (field, value) => {
                    content.querySelector(`[data-detail="${field}"]`).textContent = value;
                };
                for (const field of ['ID', 'Method', 'Proto', 'RemoteAddr']) {
                    setText(field, request[field]);
                }
                const method = content.querySelector('[data-detail="Method"]');
                method.className = `inline-flex items-center rounded-full px-2.5 py-1 text-xs font-semibold ${getMethodColor(request.Method)}`;
                setText('Timestamp', formatTime(request.Timestamp));
                setText('RequestURI', request.RequestURI || request.Path);

                const fillValues = (field, values, separator) => {
                    const list = content.querySelector(`[data-detail="${field}"]`);
                    for (const key of Object.keys(values || {}).sort()) {
                        const row = document.createElement('div');
                        row.className = 'rounded-lg bg-slate-50 px-3 py-2';
                        const name = document.createElement('dt');
                        name.className = 'text-xs font-semibold uppercase tracking-wide text-slate-500 break-all';
                        name.textContent = key;
                        const value = document.createElement('dd');
                        value.className = 'mt-1 text-sm text-slate-900 font-mono break-all';
                        value.textContent = values[key].join(separator);
                        row.append(name, value);
                        list.appendChild(row);
                    }
                };
                fillValues('Headers', request.Headers, '');
                fillValues('QueryParams', request.QueryParams, ', ');
                const hasQuery = Object.keys(request.QueryParams || {}).length > 0;
                content.querySelector('#query-content').dataset.hasContent = String(hasQuery);
                content.querySelector('[data-detail="QueryParams"]').classList.toggle('hidden', !hasQuery);
                content.querySelector('[data-i18n="no_query_parameters"]').classList.toggle('hidden', hasQuery);

                const body = request.Body || '';
                let formattedBody = body;
                try {
                    // Indent JSON without changing number precision or string escapes.
                    // Parsing and re-stringifying would round large integer values.
                    JSON.parse(body);
                    const tokens = body.match(/"(?:\\.|[^"\\])*"|[{}\[\],:]|[^\s{}\[\],:]+/g) || [];
                    let depth = 0;
                    const parts = [];
                    for (let i = 0; i < tokens.length; i++) {
                        const token = tokens[i];
                        if (token === '{' || token === '[') {
                            parts.push(token);
                            depth++;
                            if (tokens[i + 1] !== '}' && tokens[i + 1] !== ']') parts.push('\n' + '  '.repeat(depth));
                        } else if (token === '}' || token === ']') {
                            depth--;
                            if (tokens[i - 1] !== '{' && tokens[i - 1] !== '[') parts.push('\n' + '  '.repeat(depth));
                            parts.push(token);
                        } else if (token === ',') {
                            parts.push(',\n' + '  '.repeat(depth));
                        } else if (token === ':') {
                            parts.push(': ');
                        } else {
                            parts.push(token);
                        }
                    }
                    formattedBody = parts.join('');
                } catch (_) {
                    // Non-JSON request bodies are displayed verbatim.
                }
                content.querySelector('#body-text code').textContent = formattedBody;
                content.querySelector('[data-detail="body-wrapper"]').classList.toggle('hidden', !body);
                content.querySelector('[data-i18n="no_body"]').classList.toggle('hidden', !!body);
                applyTranslations(content);
                return content;
            }

            async function loadRequestDetails(url, { pushHistory = false } = {}) {
                if (detailsController) detailsController.abort();
                const controller = new AbortController();
                detailsController = controller;
                const main = document.querySelector('main');
                main.setAttribute('aria-busy', 'true');
                detailsLoadError.classList.add('hidden');

                try {
                    const requestId = url.searchParams.get('view_id');
                    const params = new URLSearchParams({ limit: '1', path: url.searchParams.get('path') || '' });
                    // History entries without a selection keep the original newest-request behavior.
                    const endpoint = requestId !== null
                        ? `/__tiny_requestbin/api/requests/${encodeURIComponent(requestId)}`
                        : `/__tiny_requestbin/api/requests?${params}`;
                    const response = await fetch(endpoint, { signal: controller.signal, cache: 'no-store' });
                    if (!response.ok) throw new Error(`HTTP ${response.status}`);
                    const data = await response.json();
                    if (controller.signal.aborted) return;

                    const request = requestId !== null ? data : (data.requests[0] || null);
                    // Fill and translate the shared template before mounting it.
                    main.replaceChildren(renderRequestDetails(request));
                    main.scrollTop = 0;
                    initRequestDetails();
                    if (pushHistory) window.history.pushState({}, '', url);
                    updateSelectedRequest(request ? String(request.ID) : null);
                } catch (error) {
                    if (controller.signal.aborted) return;
                    console.error('Error loading request details:', error);
                    detailsLoadError.textContent = translations[currentLang]['details_load_failed'];
                    detailsLoadError.classList.remove('hidden');
                } finally {
                    if (detailsController === controller) {
                        main.removeAttribute('aria-busy');
                        detailsController = null;
                    }
                }
            }

            function initRequestDetails() {
                // --- Collapsible sections logic ---
                const sections = ['headers', 'query', 'body'];

                sections.forEach(section => {
                    const toggle = document.getElementById(section + '-toggle');
                    const content = document.getElementById(section + '-content');
                    const chevron = document.getElementById(section + '-chevron');
                    const storageKey = section + 'Collapsed';

                    const setCollapsedState = (isCollapsed, isInitial) => {
                        if(isCollapsed) {
                            content.classList.add('hidden');
                            chevron.classList.add('rotate-180');
                        } else {
                            content.classList.remove('hidden');
                            chevron.classList.remove('rotate-180');
                        }
                        if (!isInitial && section !== 'query') {
                             localStorage.setItem(storageKey, isCollapsed);
                        }
                    };

                    if (toggle) {
                         toggle.addEventListener('click', () => {
                            const isCollapsed = !content.classList.contains('hidden');
                            setCollapsedState(isCollapsed, false);
                        });
                    }

                    if (content) {
                        let initiallyCollapsed;
                        if (section === 'query') {
                            initiallyCollapsed = content.dataset.hasContent === 'false';
                        } else {
                            const savedCollapsed = localStorage.getItem(storageKey);
                            initiallyCollapsed = savedCollapsed === 'true';
                        }
                        setCollapsedState(initiallyCollapsed, true);
                    }
                });

                const copyBodyBtn = document.getElementById('copy-body-btn');
                if (copyBodyBtn) {
                    copyBodyBtn.addEventListener('click', async () => {
                        const bodyText = document.getElementById('body-text');
                        if (bodyText) {
                            try {
                                // Get the text content without HTML tags
                                const textToCopy = bodyText.textContent || bodyText.innerText;
                                await copyText(textToCopy);

                                // Visual feedback
                                const originalContent = copyBodyBtn.innerHTML;
                                copyBodyBtn.innerHTML = `
                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                    </svg>
                                    <span data-i18n="copied">${translations[currentLang]['copied']}</span>
                                `;
                                copyBodyBtn.classList.remove('bg-blue-600', 'hover:bg-blue-700');
                                copyBodyBtn.classList.add('bg-green-600', 'hover:bg-green-700');

                                // Reset after 2 seconds
                                setTimeout(() => {
                                    copyBodyBtn.innerHTML = originalContent;
                                    copyBodyBtn.classList.remove('bg-green-600', 'hover:bg-green-700');
                                    copyBodyBtn.classList.add('bg-blue-600', 'hover:bg-blue-700');
                                }, 2000);

                            } catch (err) {
                                console.error('Failed to copy text: ', err);
                                // Show error feedback
                                const originalContent = copyBodyBtn.innerHTML;
                                copyBodyBtn.innerHTML = `
                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                    </svg>
                                    <span>${translations[currentLang]['copy_failed']}</span>
                                `;
                                copyBodyBtn.classList.remove('bg-blue-600', 'hover:bg-blue-700');
                                copyBodyBtn.classList.add('bg-red-600', 'hover:bg-red-700');

                                setTimeout(() => {
                                    copyBodyBtn.innerHTML = originalContent;
                                    copyBodyBtn.classList.remove('bg-red-600', 'hover:bg-red-700');
                                    copyBodyBtn.classList.add('bg-blue-600', 'hover:bg-blue-700');
                                }, 2000);
                            }
                        }
                    });
                }
            }

            initRequestDetails();

            // --- Copy button functionality ---
            const copySubtitleBtn = document.getElementById('copy-subtitle-btn');
            if (copySubtitleBtn) {
                copySubtitleBtn.addEventListener('click', async () => {
                    try {
                        await copyText(getSubtitleCopyUrl());

                        const originalContent = copySubtitleBtn.innerHTML;
                        copySubtitleBtn.innerHTML = `
                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                        `;
                        copySubtitleBtn.classList.remove('text-gray-500', 'hover:text-gray-800');
                        copySubtitleBtn.classList.add('text-green-600');
                        copySubtitleBtn.title = translations[currentLang]['copied'];
                        copySubtitleBtn.setAttribute('aria-label', translations[currentLang]['copied']);

                        setTimeout(() => {
                            copySubtitleBtn.innerHTML = originalContent;
                            copySubtitleBtn.classList.remove('text-green-600');
                            copySubtitleBtn.classList.add('text-gray-500', 'hover:text-gray-800');
                            const copyLabel = translations[currentLang]['copy_example_url'] || 'Copy example URL';
                            copySubtitleBtn.title = copyLabel;
                            copySubtitleBtn.setAttribute('aria-label', copyLabel);
                        }, 2000);
                    } catch (err) {
                        console.error('Failed to copy subtitle URL: ', err);

                        const originalContent = copySubtitleBtn.innerHTML;
                        copySubtitleBtn.innerHTML = `
                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        `;
                        copySubtitleBtn.classList.remove('text-gray-500', 'hover:text-gray-800');
                        copySubtitleBtn.classList.add('text-red-600');
                        copySubtitleBtn.title = translations[currentLang]['copy_failed'];
                        copySubtitleBtn.setAttribute('aria-label', translations[currentLang]['copy_failed']);

                        setTimeout(() => {
                            copySubtitleBtn.innerHTML = originalContent;
                            copySubtitleBtn.classList.remove('text-red-600');
                            copySubtitleBtn.classList.add('text-gray-500', 'hover:text-gray-800');
                            const copyLabel = translations[currentLang]['copy_example_url'] || 'Copy example URL';
                            copySubtitleBtn.title = copyLabel;
                            copySubtitleBtn.setAttribute('aria-label', copyLabel);
                        }, 2000);
                    }
                });
            }

        });
    </script>
</body>
